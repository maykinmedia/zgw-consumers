#: models/services.py:37
msgid "service slug"
msgstr "service slug"

#: models/services.py:42
msgid ""
"A unique, human-friendly slug to identify this service. Primarily useful for "
"cross-instance import/export."
msgstr ""
"Een unieke, voor mensen leesbare identificatie om deze service te herkennen. "
"Hoofdzakelijk nuttig voor importeren en exporteren."

#: models/services.py:47
msgid "type"
msgstr "type"

#: models/services.py:49
msgid "api root url"
msgstr "basisurl van de API"

#: models/services.py:51
msgid ""
"The root URL of the service that will be used to construct the URLs when "
"making requests."
msgstr ""
"De basis-URL van de service om volledige URLs op te bouwen bij het maken van "
"verzoeken."

#: models/services.py:58
msgid "connection check endpoint"
msgstr "endpoint verbindingstest"

#: models/services.py:60
msgid ""
"A relative URL to perform a connection test. If left blank, the API root "
"itself is used. This connection check is only performed in the admin when "
"viewing the service configuration."
msgstr ""
"Een pad/relatieve URL waartegen de verbindingstest uitgevoerd wordt. Indien "
"geen waarde opgegeven is, dan wordt de basisurl van de API gebruikt. The "
"verbindingstest wordt enkel uitgevoerd in de beheerpagina wanneer de "
"instellingen weergegeven worden."

#: models/services.py:73
msgid "authorization type"
msgstr "authorisatietype"

#: models/services.py:77
msgid "The type of authorization to use for this service."
msgstr "De soort autorisatie die op deze service van toepassing is."

#: models/services.py:84
msgid ""
"The client ID used to construct the JSON Web Token to connect with the "
"service (only needed if auth type is `zgw` or `oauth2_client_credentials`)."
msgstr ""
"De client-iD die in het JSON Web Token opgenomen wordt om zich te "
"authenticeren bij de service (enkel nodig bij autorisatietype `zgw` of "
"`oauth2_client_credentials`)."

#: models/services.py:93
msgid ""
"The secret used to construct the JSON Web Token to connect with the service "
"(only needed if auth type is `zgw` or `oauth2_client_credentials`)."
msgstr ""
"De geheime sleutel waarmee het JSON Web Token ondertekend wordt om zich bij "
"de service te authenticeren (enkel nodig bij autorisatietype `zgw`of "
"`oauth2_client_credentials`)."

#: models/services.py:100
msgid "OAuth2 token url"
msgstr "OAuth2 token-endpoint"

#: models/services.py:104
msgid ""
"OAuth2 token endpoint for client credentials flow. (Only needed if auth type "
"is OAuth2)"
msgstr ""
"De token-endpoint waar client-ID en secret uitgewisseld worden voor een "
"token (enkel relevant voor de OAuth2-authenticatietype(n))."

#: models/services.py:110
msgid "OAuth2 scope"
msgstr "OAuth2 scope"

#: models/services.py:114
msgid ""
"Optional OAuth2 scope (space-separated). Included in the token request body "
"if defined. (Only needed if auth type is OAuth2)"
msgstr ""
"Eventuele Oauth2 scope-namen om voor te autoriseren, gescheiden met spaties. "
"Deze wordt meegestuurd bij het ophalen van een autorisatietoken (enkel "
"relevant voor de OAuth2-authenticatietype(n))."

#: models/services.py:121
msgid "OAuth2 token method"
msgstr "OAuth2 token-methode"

#: models/services.py:126
msgid ""
"Whether to include the credentials as a request header (under Authorization) "
"or in the body."
msgstr ""
"Selecteer of de authenticatiegegevens in een verzoek-header (Authorization) "
"of in de body van het verzoek opgenomen wordt."

#: models/services.py:131
msgid "JWT expires after"
msgstr "JWT vervalt na"

#: models/services.py:134
msgid ""
"How long a JWT is valid for, in seconds. This controls the 'exp' claim (only "
"used if auth type is `zgw`)."
msgstr ""
"Bepaalt de geldigheidsduur van een JWT, in seconden. Deze parameter heeft "
"invloed op de 'exp' claim (enkel relevant bij autorisatietype `zgw`)."

#: models/services.py:140
msgid "header key"
msgstr "header sleutel"

#: models/services.py:144
msgid ""
"The header key used to store the API key (only needed if auth type is "
"`api_key`)."
msgstr ""
"De naam van de header die de API-key bevat (enkel nodig bij autorisatietype "
"`api_key`)."

#: models/services.py:149
msgid "header value"
msgstr "header waarde"

#: models/services.py:153
msgid ""
"The API key to connect with the service (only needed if auth type is "
"`api_key`)."
msgstr ""
"De waarde voor de API-key header (enkel nodig bij autorisatietype `api_key`)."

#: models/services.py:158
msgid "NLX url"
msgstr "NLX-url"

#: models/services.py:158
msgid "NLX (outway) address."
msgstr "NLX (outway)-adres"

#: models/services.py:161
msgid "user ID"
msgstr "gebruikers-ID"

#: models/services.py:165
msgid ""
"User ID to use for the audit trail. Although these external API credentials "
"are typically used by this API itself instead of a user, the user ID is "
"required."
msgstr ""

#: models/services.py:171
msgid "user representation"
msgstr "gebruikersweergave"

#: models/services.py:174
msgid "Human readable representation of the user."
msgstr "Weergave van de gebruikersidentiteit voor mensen."

#: models/services.py:180
msgid "The SSL/TLS certificate of the client"
msgstr "Het SSL/TLS-certificaat van de client"

#: models/services.py:188
msgid "The SSL/TLS certificate of the server"
msgstr "Het SSL/TLS-certificaat van de server"

#: models/services.py:193
msgid "timeout"
msgstr "time-out"

#: models/services.py:194
msgid "Timeout (in seconds) for HTTP calls."
msgstr ""
"Time-out (in seconden) voor HTTP-calls. Na het verstrijken wordt het verzoek "
"afgebroken."

#: models/services.py:203
msgid "service"
msgstr "service"

#: models/services.py:204
msgid "services"
msgstr "services"

#: models/services.py:229
#, python-brace-format
msgid "If field '{header_key}' is set, field '{header_value}' must also be set"
msgstr ""
"Als het veld '{header_key}' opgegeven is, dan moet je ook een waarde opgeven "
"voor het '{header_value}'-veld."

#: models/services.py:241
#, python-brace-format
msgid "If field '{header_value}' is set, field '{header_key}' must also be set"
msgstr ""
"Als het veld '{header_value}' opgegeven is, dan moet je ook een waarde "
"opgeven voor het '{header_key}'-veld."

#: models/services.py:255
#, python-brace-format
msgid "The field '{field_name}' is required for ZGW authentication"
msgstr "Het veld '{field_name}' is verplicht voor ZGW-authenticatie."

#: models/services.py:266
msgid ""
"Additional libraries are required to use OAuth, which aren't installed. "
"Select another method."
msgstr ""
"Er zijn extra systeembibliotheken nodig om OAuth2 te kunnen gebruiken, die "
"niet beschikbaar zijn. Kies een ander type."

#: models/services.py:285
#, python-brace-format
msgid "The field '{field_name}' is required for OAuth2 client credentials flow"
msgstr ""
"Het veld '{field_name}' is verplicht voor de OAuth2 OAuth2-"
"authenticatietype(n)."

#: models/services.py:336
msgid "NLX directory"
msgstr "NLX directory"

#: models/services.py:339
msgid "NLX outway address"
msgstr "NLX-outway adres"

#: models/services.py:341
msgid "Example: http://my-outway.nlx:8080"
msgstr "Voorbeeld: http://mijn-outway.nl:8080"

#: models/services.py:347
msgid ""
"Your organization TLS certificate for the NLX network. This is used to fetch "
"the list of available services from the NLX directory API."
msgstr ""
"Het TLS-certificaat van jouw organisatie voor het NLX-netwerk. Dit wordt "
"gebruikt om de lijst van beschikbare services uit de NLX directory API op te "
"halen."

#: models/services.py:354
msgid ""
"Your organization TLS private key for the NLX network. This is used to fetch "
"the list of available services from the NLX directory API."
msgstr ""
"De TLS-privésleutel voor het NLX-netwerk. Dit wordt gebruikt om de lijst van "
"beschikbare services uit de NLX directory API op te halen."

#: models/services.py:361
msgid "NLX configuration"
msgstr "NLX-configuratie"

#: models/services.py:392
msgid "Connection refused. Please provide a correct address."
msgstr "Verbinding geweigerd. Geef een valide adres op."

#: models/validators.py:13
msgid "Value cannot be a URL"
msgstr "De waarde mag geen volledige URL zijn."

